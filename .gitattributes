# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Explicit text types
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.svg     text eol=lf
*.xml     text eol=lf

# Binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.pdf     binary
